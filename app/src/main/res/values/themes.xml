<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
      Material 3 (Material You look) with a cheerful static seed palette.
      On Android 12+ KidsHomeApp applies DynamicColors when available.
    -->
    <style name="Theme.KidsHome" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/md_primary</item>
        <item name="colorOnPrimary">@color/md_on_primary</item>
        <item name="colorPrimaryContainer">@color/md_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/md_on_primary_container</item>
        <item name="colorSecondary">@color/md_secondary</item>
        <item name="colorOnSecondary">@color/md_on_secondary</item>
        <item name="colorSecondaryContainer">@color/md_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/md_on_secondary_container</item>
        <item name="colorTertiary">@color/md_tertiary</item>
        <item name="colorOnTertiary">@color/md_on_tertiary</item>
        <item name="colorTertiaryContainer">@color/md_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/md_on_tertiary_container</item>
        <item name="colorError">@color/md_error</item>
        <item name="colorOnError">@color/md_on_error</item>
        <item name="colorErrorContainer">@color/md_error_container</item>
        <item name="colorOnErrorContainer">@color/md_on_error_container</item>
        <item name="android:colorBackground">@color/md_background</item>
        <item name="colorOnBackground">@color/md_on_background</item>
        <item name="colorSurface">@color/md_surface</item>
        <item name="colorOnSurface">@color/md_on_surface</item>
        <item name="colorSurfaceVariant">@color/md_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/md_on_surface_variant</item>
        <item name="colorOutline">@color/md_outline</item>
        <item name="colorOutlineVariant">@color/md_outline_variant</item>
        <item name="shapeAppearanceSmallComponent">@style/Shape.KidsHome.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/Shape.KidsHome.Medium</item>
        <item name="shapeAppearanceLargeComponent">@style/Shape.KidsHome.Large</item>
        <item name="materialButtonStyle">@style/Widget.KidsHome.Button</item>
        <item name="materialCardViewStyle">@style/Widget.KidsHome.Card</item>
        <item name="toolbarStyle">@style/Widget.KidsHome.Toolbar</item>
        <!-- Track themed primary so Dynamic Color and the app bar stay in sync. -->
        <item name="android:statusBarColor">?attr/colorPrimary</item>
        <item name="android:navigationBarColor">?attr/colorSurface</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">false</item>
    </style>

    <!-- Back-compat alias used by the manifest -->
    <style name="AppTheme" parent="Theme.KidsHome" />

    <!--
      API 35 only (see Dialogs). Opts the floating PIN / parent dialogs out of
      edge-to-edge so the platform keeps them above the bars and the IME.
      Activities stay edge-to-edge and apply insets themselves.
    -->
    <style name="Theme.KidsHome.Dialog" parent="Theme.Material3.DayNight.Dialog.Alert">
        <item name="android:windowOptOutEdgeToEdgeEnforcement" tools:targetApi="35">true</item>
        <item name="colorPrimary">@color/md_primary</item>
        <item name="colorOnPrimary">@color/md_on_primary</item>
        <item name="colorPrimaryContainer">@color/md_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/md_on_primary_container</item>
        <item name="colorSecondary">@color/md_secondary</item>
        <item name="colorOnSecondary">@color/md_on_secondary</item>
        <item name="colorSecondaryContainer">@color/md_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/md_on_secondary_container</item>
        <item name="colorError">@color/md_error</item>
        <item name="colorOnError">@color/md_on_error</item>
        <item name="colorSurface">@color/md_surface</item>
        <item name="colorOnSurface">@color/md_on_surface</item>
        <item name="colorOnSurfaceVariant">@color/md_on_surface_variant</item>
        <item name="android:colorBackground">@color/md_background</item>
    </style>

    <style name="Theme.KidsHome.Kid" parent="Theme.KidsHome">
        <item name="android:windowFullscreen">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>

    <style name="Theme.KidsHome.Lock" parent="Theme.KidsHome">
        <item name="android:statusBarColor">@color/lock_bg_timeup</item>
        <item name="android:navigationBarColor">@color/lock_bg_timeup</item>
        <item name="android:windowBackground">@color/lock_bg_timeup</item>
    </style>

    <style name="Theme.KidsHome.Pin" parent="Theme.KidsHome">
        <item name="android:windowBackground">@color/md_background</item>
    </style>

    <style name="Shape.KidsHome.Small" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/corner_sm</item>
    </style>

    <style name="Shape.KidsHome.Medium" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/corner_md</item>
    </style>

    <style name="Shape.KidsHome.Large" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/corner_lg</item>
    </style>

    <style name="Widget.KidsHome.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">@dimen/corner_md</item>
        <item name="android:minHeight">@dimen/touch_min</item>
    </style>

    <style name="Widget.KidsHome.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="cornerRadius">@dimen/corner_md</item>
        <item name="android:minHeight">@dimen/touch_min</item>
    </style>

    <style name="Widget.KidsHome.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">@dimen/touch_min</item>
    </style>

    <style name="Widget.KidsHome.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/section_card_radius</item>
        <item name="cardElevation">@dimen/card_elevation</item>
        <item name="contentPadding">@dimen/space_md</item>
    </style>

    <style name="Widget.KidsHome.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="titleTextColor">?attr/colorOnPrimary</item>
        <item name="subtitleTextColor">?attr/colorOnPrimary</item>
        <item name="android:background">?attr/colorPrimary</item>
        <item name="navigationIconTint">?attr/colorOnPrimary</item>
    </style>

    <style name="TextAppearance.KidsHome.Display" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="TextAppearance.KidsHome.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.KidsHome.Section" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.KidsHome.Body" parent="TextAppearance.Material3.BodyMedium" />

    <!-- Empty parent so dotted Widget.KidsHome.* names resolve under AAPT. -->
    <style name="Widget.KidsHome" parent="android:Widget" />

    <!-- Plain TextView keys — MaterialButton insets clip digits in circular keys. -->
    <style name="Widget.KidsHome.PinKey" parent="Widget.KidsHome">
        <item name="android:layout_width">@dimen/pin_key_size</item>
        <item name="android:layout_height">@dimen/pin_key_size</item>
        <item name="android:background">@drawable/bg_pin_key</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textSize">@dimen/pin_key_text</item>
        <item name="android:textStyle">bold</item>
        <item name="android:padding">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
    </style>
</resources>
